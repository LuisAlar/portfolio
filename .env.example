# ---- Photo pipeline (scripts/photos/sync.mjs) ----
# Copy to .env (or .env.local) and fill in. Never prefix secrets with VITE_ (that ships them to the browser).

# "local" writes to public/photos-local for dev; "r2" uploads to Cloudflare R2.
PHOTOS_TARGET=r2

# Cloudflare dashboard -> R2 -> Manage R2 API Tokens (Object Read & Write, scoped to this bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=portfolio-photos

# Optional: any other S3-compatible provider (Backblaze B2, MinIO...). Overrides the R2 endpoint.
# S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# S3_REGION=us-west-004

# ---- Browser (public) ----
# Where the browser loads photos from. Leave unset in dev to use /photos-local.
#   "/"                          -> same origin; vercel.json proxies /photos/* to the bucket's r2.dev URL
#                                   and Vercel's CDN caches it (use this with a *.vercel.app domain)
#   "https://pub-xxxx.r2.dev"    -> straight from R2 (rate-limited, fine for testing)
#   "https://photos.example.com" -> an R2 custom domain, if you ever buy a domain
VITE_PHOTOS_BASE_URL=
